<Window x:Class="PawnAppraiser.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PawnAppraiser.Desktop" Title="深空当铺鉴定助手" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{StaticResource Text}" FontFamily="Microsoft YaHei UI" FontSize="13" ResizeMode="NoResize" ShowInTaskbar="False" Width="440" Height="800" MinWidth="320" MinHeight="430">
 <Border x:Name="Shell" BorderBrush="#FF465B73" BorderThickness="1" CornerRadius="10" Padding="10,0,10,10">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="DragTitle" AutomationProperties.Name="窗口标题栏">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="深空当铺 · 鉴定" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
    <Button Grid.Column="1" Content="⚙" ToolTip="设置" Click="OpenSettings" Padding="7,2" Margin="2" AutomationProperties.Name="设置"/>
    <Button x:Name="CollapseButton" Grid.Column="2" Content="−" ToolTip="收起/展开 · 小键盘 *" Click="ToggleCollapse" Padding="9,2" Margin="2" AutomationProperties.Name="收起或展开"/>
    <Button Grid.Column="3" Content="×" ToolTip="隐藏到托盘 · 小键盘 /" Click="HideClicked" Padding="9,2" Margin="2" AutomationProperties.Name="关闭到托盘"/>
   </Grid>
   <Grid x:Name="ExpandedContent" Grid.Row="1" SizeChanged="ContentSizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" DisplayMemberPath="DisplayName" AutomationProperties.Name="鉴定物品" Margin="2,5,2,8"/>
    <TextBlock x:Name="DiagnosticBanner" Grid.Row="1" Foreground="#FFFFC879" TextWrapping="Wrap" FontSize="11" MaxHeight="55" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="2,0,2,4"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
     <ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Margin="0,4,0,10">
       <DockPanel Margin="4,0,4,5"><TextBlock Text="{Binding Hint}" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/></DockPanel>
       <ItemsControl ItemsSource="{Binding Options}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:ResponsiveOptionsPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
        <ToggleButton IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding ToggleCommand}" Margin="3" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Label}"><StackPanel><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Delta}" Foreground="#FFB8D3DD" FontSize="12" Margin="0,3,0,0"/></StackPanel></ToggleButton>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
    <Border Grid.Row="3" BorderBrush="#FF465B73" BorderThickness="0,1,0,0" Margin="2,6,2,0" Padding="0,8,0,0" Background="#FF142032">
     <StackPanel Margin="6,0">
      <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="30" FontSize="11"/>
      <TextBlock Text="{Binding Bonuses}" ToolTip="{Binding Bonuses}" Foreground="#FF6DE0D4" TextWrapping="Wrap" MaxHeight="32" FontSize="12" Margin="0,3,0,0"/>
      <Button x:Name="PriceButton" Command="{Binding CopyCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" ToolTip="点击价格复制纯数字" AutomationProperties.Name="点击价格复制"><Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="56"><TextBlock Text="{Binding Price}" FontSize="42" FontWeight="Bold" Foreground="#FF89E5F3"/></Viewbox></Button>
      <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="复制数字" Command="{Binding CopyCommand}" Margin="0,0,4,0"/><Button Grid.Column="1" Content="下一件" Command="{Binding ResetCommand}" Margin="4,0,0,0"/></Grid>
      <TextBlock Text="{Binding Feedback}" ToolTip="{Binding Feedback}" Foreground="#FFFFD38B" TextWrapping="Wrap" MinHeight="18" MaxHeight="30" FontSize="11" Margin="0,4,0,0"/>
      <Expander x:Name="DetailsExpander" Header="计算明细" FontSize="11" Margin="0,2,0,2"><ScrollViewer x:Name="DetailsScroller" MaxHeight="145" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="2,5" Foreground="{StaticResource Muted}"/></ScrollViewer></Expander>
     </StackPanel>
    </Border>
   </Grid>
   <Thumb x:Name="ResizeGrip" Grid.Row="1" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeDrag" ToolTip="拖动调整尺寸"><Thumb.Template><ControlTemplate><TextBlock Text="◢" Foreground="#FF73ACBF" FontSize="15"/></ControlTemplate></Thumb.Template></Thumb>
  </Grid>
 </Border>
</Window>
