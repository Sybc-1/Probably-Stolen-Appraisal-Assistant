<Window x:Class="PawnAppraiser.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="鉴定助手设置" Width="410" Height="470" MinWidth="360" MinHeight="420" WindowStartupLocation="CenterOwner" Background="#FF142032" Foreground="{StaticResource Text}" FontFamily="Microsoft YaHei UI" FontSize="13" Topmost="True" ShowInTaskbar="False">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <CheckBox x:Name="TopmostBox" Content="窗口始终置顶"/>
   <TextBlock Text="背景不透明度（文字保持不透明）" Margin="0,10,0,4"/>
   <Slider x:Name="OpacitySlider" Minimum="0.85" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
   <TextBlock Text="展开 / 收起快捷键" Margin="0,18,0,4"/><ComboBox x:Name="CollapseKeys" DisplayMemberPath="Name"/>
   <TextBlock Text="显示 / 隐藏快捷键" Margin="0,12,0,4"/><ComboBox x:Name="VisibilityKeys" DisplayMemberPath="Name"/>
   <TextBlock Text="默认：小键盘 * / 小键盘 /。冲突时可改用功能键。" TextWrapping="Wrap" Foreground="#FFABBBD0" Margin="0,10"/>
   <TextBlock x:Name="SavePath" TextWrapping="Wrap" FontSize="11" Foreground="#FFABBBD0"/>
   <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFFFBD78" Margin="0,8"/>
  </StackPanel></ScrollViewer>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="取消" IsCancel="True" Margin="0,8,6,0"/><Button Grid.Column="1" Content="保存" IsDefault="True" Click="Save" Margin="6,8,0,0"/></Grid>
 </Grid>
</Window>
