          "id": "intact",
          "label": "完整未拆封",
          "priceDelta": 0,
          "displayOrder": 0
        },
        {
          "id": "opened",
          "label": "已撕开",
          "priceDelta": 0,
          "displayOrder": 1
        },
        {
          "id": "missing",
          "label": "包装缺失",
          "priceDelta": 0,
          "displayOrder": 2
        }
      ]
    },
